# Copy this file to .env and fill in your key. NEVER commit .env
LLM_PROVIDER=gemini
GEMINI_API_KEY=paste-your-key-here
# Free-tier model names change over time: check aistudio.google.com
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional backup (console.groq.com). Set LLM_PROVIDER=groq to use it.
GROQ_API_KEY=

# Turn off the reranker if your laptop is slow: RERANKER=none
RERANKER=fastembed
